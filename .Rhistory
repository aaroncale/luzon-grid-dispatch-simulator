y0 <- f(x0)
y1 <- f(x1)
y2 <- f(x2)
# Step 2: Computer step differences between consecutive x values
h0 <- x1 - x0
h1 <- x2 - x1
# Step 3: Compute divided differences
d0 <- (y1 - y0) / h0
d1 <- (y2 - y1) / h1
# Step 4: Calculate Muller's parabola coefficients (A, B, C)
A <- (d1 - d0) / (h1 + h0)
B <- A * h1 + d1
C <- y2 # C is simple f(x2)
# Step 5: Comptue discriminant sqrt(B^2 - 4AC)
disc <- sqrt(as.complex(B^2 - 4 * A * C))
# Calculate both possible denominator terms for the quadratic formula
denom1 <- B + disc
denom2 <- B - disc
# Choose the denominator with the larger absolute value (magnitude) to minimize roundoff error
if (Mod(denom1) >= Mod(denom2)) {
denom <- denom1
} else {
denom <- denom2
}
# Step 6: Calculate correction dx3 and new root estimate x3
dx3 <- (-2 * C) / denom
x3 <- x2 + dx3
y3 <- f(x3) # Evaluate function at new estimate x3
# Step 7: Compute relative approximate error
ea <- Mod((x3 - x2) / x3)
# Step 8: Print current iteration results if verbose is enabled
if (verbose) {
cat(sprintf("%-4d %-10s %-10s %-10s %-12s %-12s %-12s %-12s %-12s %-12s %-10s %-12s %-12s\n",
num_iterations, format(x0, digits = 4), format(x1, digits = 4), format(x2, digits = 4),
format(y0, digits = 4), format(y1, digits = 4), format(y2, digits = 4),
format(A, digits = 4), format(B, digits = 4), format(C, digits = 4),
format(x3, digits = 4), format(y3, digits = 4), format(ea, digits = 4)))
}
# Step 9: Reassign variables for next iteration
x0 <- x1
x1 <- x2
x2 <- x3
}
# Convert to real if imaginary part is negligible
if (is.complex(x3) && abs(Im(x3)) < 1e-12) x3 <- Re(x3)
if (is.complex(A) && abs(Im(A)) < 1e-12) A <- Re(A)
if (is.complex(B) && abs(Im(B)) < 1e-12) B <- Re(B)
if (is.complex(C) && abs(Im(C)) < 1e-12) C <- Re(C)
return(list(
f = f,
coefficients = c(A = A, B = B, C = C),
root = x3,
iterations = num_iterations,
ea = ea
))
}
